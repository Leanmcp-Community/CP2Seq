  "protocol": {
    "purpose": "Estimate the effect of decision support at frozen states; not identify an internal cognitive defect.",
    "selection": "10 retrospectively selected mixed-outcome tasks; first success/failure pair with a shared-state route witness, last failure departure from that state. Not representative of all20 tasks.",
    "baseline": "Original full prompt plus identical legal-fold menu; original tools retained. Not the historical untreated baseline.",
    "intervention": "One support is added at the frozen decision only; later calls use normal prompts. Same low effort and original early-stop counters.",
    "repeats": 3,
    "continuation_call_cap": 20,
    "primary": "Immediate choice: previously used transition, rejected action, or recovery action. Paired by node; repeated runs nested within nodes.",
    "secondary": "Reached E_id within horizon and submitted E_id at finish, reported separately; actual new calls, tokens, wall time and preview engine cost.",
    "caveats": [
      "Additional prompt length is not matched: effects belong to the whole support package, not a pure cognitive mechanism.",
      "No-information memory nodes must be reported separately.",
      "A known successful route is a witness, not an exhaustive label of viable branches.",
      "Uniform previews consume extra engine work. Equal model-call caps are not equal compute budgets.",
      "No claim that restarts outperform long episodes; pass@5 remains stability analysis."
    ]
  }
