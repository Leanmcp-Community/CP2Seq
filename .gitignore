.DS_Store
Sim-FAST-PY/
venv/
__pycache__/

# synthetic corpus runs — rebuildable from the seed, so scratch batches stay out...
# (the pattern must be out/* rather than out/: git cannot re-include anything under an
#  excluded DIRECTORY, so excluding the children is what makes the negations below work)
workspace/corpus/out/*
# ...but the RELEASED batches are versioned, because a dataset nobody can point at is not
# a dataset. Regenerating from the seed gives the same bytes; that is the argument for not
# versioning it, and it is not an argument a reader of the paper can act on.
!workspace/corpus/out/batch1/
!workspace/corpus/out/layers-batch1/
# the release corpus itself (one merged manifest over every batch)
!workspace/corpus/out/release/
# the named models: twenty authored fold sequences, small and cited by the paper's figures
!workspace/corpus/out/named/

# inspector build output — rebuilt by build-showcase.mjs
# (superseded by browser.html, which is versioned: it loads out/release/index.json at runtime
#  instead of inlining every sample, so it does not have to be regenerated or committed as a blob)
workspace/corpus/inspector.html

# leftover external-data caches from before the outside sources were removed;
# ignored so they never re-enter the repo
workspace/purelandfold/
DHEERAJ_WORKSPACE/data/
DHEERAJ_WORKSPACE/baseline/results.json
DHEERAJ_WORKSPACE/baseline/mixed-run.txt
DHEERAJ_WORKSPACE/baseline/pureland-results.json
DHEERAJ_WORKSPACE/baseline/pureland-run.txt
DHEERAJ_WORKSPACE/pureland/viewer.html
DHEERAJ_WORKSPACE/pureland/viz-data.json
DHEERAJ_WORKSPACE/pureland/dist/

# Local search artifacts; regenerate with baseline_python/run.py
DHEERAJ_WORKSPACE/experiments/
DHEERAJ_WORKSPACE/exports/

# Python environments, caches, and local configuration
.venv/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.env
.env.*
!.env.example

# Local viewer logs
DHEERAJ_WORKSPACE/viewer/*.log


# Local experiment monitor logs, process IDs, and locks
/CODEX_HARNESS_TESTING/matched40-state/

# Detailed CP-distance exports; retain summary.json and paper-table.tex
/workspace/RESULTS/cp-distance/per-attempt/
/workspace/RESULTS/cp-distance/attempts.json
/workspace/RESULTS/cp-distance/attempts.jsonl
/workspace/RESULTS/cp-distance/index.json

# LaTeX build intermediates; retain paper PDFs and bibliography output
*.aux
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
/PAPER_FINAL/**/*.log
/PAPER_FINAL/**/*.out

# Local corpus and run artifacts; large, machine-local, regenerated rather than versioned
workspace/corpus_provenance/
workspace/mid_all_layers/

